[Desktop Entry]
Version=1.0
Type=Application
Name=Window Tiling panel setup
Comment=Add the Window Tiling and Resolution widgets to the panel once per user
Exec=plasma-tile-menu setup --auto
Terminal=false
NoDisplay=true
OnlyShowIn=KDE;
X-KDE-autostart-phase=2
